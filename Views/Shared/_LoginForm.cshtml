@model LoginViewModel
<div class="auth-card">
    <partial name="_CloseButton" />
    <h2 id="login-title">Welcome back</h2>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="field">
            <label for="login-identifier">Email or username</label>
            <input asp-for="Identifier" id="login-identifier" autocomplete="username" autofocus />
            <span asp-validation-for="Identifier" class="field-error"></span>
        </div>

        <div class="field">
            <label for="login-password">Password</label>
            <input asp-for="Password" id="login-password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <label class="check">
            <input asp-for="RememberMe" id="login-remember" />
            <span>Remember me</span>
        </label>

        <button type="submit" class="btn btn-primary btn-block">Sign in</button>
    </form>

    <p class="auth-switch">
        New here?
        <a asp-controller="Account" asp-action="Register" data-open-dialog="register-dialog">Create an account</a>
    </p>
</div>
